<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <shape android:shape="oval">
            <solid android:color="@color/primary_purple_light" />
            <stroke android:width="2dp" android:color="@color/primary_purple" />
        </shape>
    </item>
    <item>
        <shape android:shape="oval">
            <solid android:color="@color/background_purple" />
            <stroke android:width="1dp" android:color="@color/text_secondary" />
        </shape>
    </item>
</selector>
