<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Theme.Winss" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/primary_purple</item>
        <item name="colorPrimaryVariant">@color/primary_purple_dark</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/accent_purple</item>
        <item name="colorOnSecondary">@color/white</item>
        <item name="android:colorBackground">@color/background_purple</item>
        <item name="colorSurface">@color/surface_purple</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="colorOnBackground">@color/text_primary</item>
    </style>

    <style name="Theme.Winss.Starting" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:windowBackground">@color/primary_purple</item>
    </style>

    <style name="Theme.Winss.Splash" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:windowTranslucentStatus">true</item>
        <item name="android:windowTranslucentNavigation">true</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:windowBackground">@color/primary_purple</item>
        <item name="android:fitsSystemWindows">false</item>
    </style>
</resources>